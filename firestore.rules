rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validCredential(username, hash) {
      let account = get(/databases/$(database)/documents/privateAccounts/$(username)).data;
      return account.enabled == true && account.passwordHash == hash;
    }
    function approvedSession() {
      let session = get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data;
      return session.createdAt + duration.value(12, 'h') > request.time
        && validCredential(session.username, session.passwordHash);
    }
    function admin() {
      let session = get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data;
      return approvedSession()
        && get(/databases/$(database)/documents/accountProfiles/$(session.username)).data.role == 'admin';
    }
    // Set these records only through the Firebase Console. Browsers cannot read hashes.
    match /privateAccounts/{username} {
      allow read, write: if false;
    }
    match /sessions/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'passwordHash', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_-]{1,32}$')
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.createdAt == request.time
        && validCredential(request.resource.data.username, request.resource.data.passwordHash);
    }
    match /accountProfiles/{username} {
      allow get: if signedIn() && approvedSession()
        && get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.username == username;
      allow write: if false;
    }
    match /tables/main {
      allow get: if signedIn() && admin();
      allow create, update: if signedIn() && admin()
        && request.resource.data.keys().hasOnly(['stateJson', 'revision', 'updatedAt'])
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() <= 900000
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
